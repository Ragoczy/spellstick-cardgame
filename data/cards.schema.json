{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spellstick card set",
  "type": "object",
  "required": ["version", "families", "opposedPairs", "teams", "cards"],
  "properties": {
    "version": { "type": "string" },
    "families": {
      "description": "Magic family ids (data/warlock-resonants.json) that affinities and spells may use. See docs/MAGIC.md.",
      "type": "array", "items": { "type": "string", "pattern": "^[a-z-]+$" }, "minItems": 1
    },
    "opposedPairs": {
      "description": "Families that weaken each other. Empty: the canon opposes Resonants, not families.",
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "color"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "placeholder": { "type": "boolean" },
          "spells": {
            "description": "The library spells in this team's deck, by card id. An id listed twice is two copies.",
            "type": "array", "items": { "type": "string" }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "team", "kind", "name"],
        "properties": {
          "id": { "type": "string", "description": "Also the art filename stem in assets/cards/." },
          "team": { "type": "string", "description": "A team id, \"pool\" for player cards in the shared pool (each game deals both sides their goalies and field players at random from it), or \"library\" for spells in the spell library (teams pick them with their \"spells\" list), or \"physical\" for physical attack cards (every team's Physical pile has one of each)." },
          "kind": { "enum": ["field", "goalie", "spell", "physical"] },
          "name": { "type": "string" },
          "role": {
            "description": "Player cards: the card's type, which says what it is good at. Any field player can still play any position.",
            "enum": ["runner", "striker", "playmaker", "allrounder", "anchor", "stopper", "goalie"]
          },
          "bonusPoints": {
            "description": "Named players: extra skill points added to the type's base stats when the card was made.",
            "type": "integer", "minimum": 0, "maximum": 4
          },
          "resonants": {
            "description": "Required for field and goalie cards. Each Resonant (e.g. Anger) has one Affinity: a whole family (\"fire\") or one specialization in it (\"fire.explosion\").",
            "type": "array", "minItems": 1, "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["name", "affinity"],
              "properties": {
                "id": { "type": "string", "description": "The Resonant's id in data/warlock-resonants.json, e.g. \"emo.anger\"." },
                "name": { "type": "string" },
                "affinity": { "type": "string", "pattern": "^[a-z-]+([.][a-z-]+)?$" }
              },
              "additionalProperties": false
            }
          },
          "speed": { "type": "integer", "minimum": 0, "maximum": 6 },
          "shot": { "type": "integer", "minimum": 0, "maximum": 6 },
          "defense": { "type": "integer", "minimum": 0, "maximum": 6 },
          "faceoff": { "type": "integer", "minimum": 0, "maximum": 6 },
          "toughness": { "type": ["integer", "null"], "description": "Field players (v0.17): knocked down, the player is fine on a roll at or below this, hurt above it. Physical cards: the modifier to the target's Toughness roll, or null for no Toughness roll." },
          "severity": { "type": ["integer", "null"], "description": "Physical cards: the modifier to the severity roll, or null for no severity roll." },
          "uses": { "enum": ["speed", "muscle"], "description": "Physical cards: speed attacks with the attacker's Speed, muscle with their Defense." },
          "bonus": { "type": "integer", "description": "Physical cards: added to the attack." },
          "affinity": { "type": "string", "pattern": "^[a-z-]+([.][a-z-]+)?$", "description": "Physical cards: the body Affinity that gives the attacker +1." },
          "from": { "type": "string", "description": "Physical cards: the sport the foul comes from (printed)." },
          "when": { "type": "string", "description": "Physical reaction cards: when you play it (printed)." },
          "save": { "type": "integer", "minimum": 0, "maximum": 8 },
          "spellType": { "enum": ["reaction", "action"] },
          "tier": { "enum": ["legendary", "rare", "uncommon", "common", "minor", "major", "brutal"], "description": "Spells: power tier, named like a card rarity, strongest first (legendary to common). Measured by npm run spell-tiers (docs/MAGIC.md). Changes nothing in play. Physical cards: penalty tier (minor, major, brutal), which sets the penalty length." },
          "magic": { "type": ["string", "null"], "pattern": "^[a-z-]+([.][a-z-]+)?$", "description": "The spell's kind of magic: a family (\"fire\") or a specialization (\"illusion.glamour\"), or null for neutral." },
          "ability": { "$ref": "#/$defs/ability" },
          "text": { "type": "string", "description": "Rules text printed on the card." },
          "flavor": { "type": "string" },
          "copies": { "type": "integer", "minimum": 1, "default": 1 },
          "addon": { "type": "boolean", "description": "True if the card belongs to the center-lane add-on." },
          "promo": { "type": "boolean" },
          "placeholder": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "field" } } },
            "then": { "required": ["resonants", "speed", "shot", "defense", "faceoff", "toughness"],
                      "properties": { "toughness": { "type": "integer", "minimum": 1, "maximum": 6 } } } },
          { "if": { "properties": { "kind": { "const": "physical" } } },
            "then": { "required": ["tier", "uses", "bonus", "affinity", "toughness", "severity", "from"],
                      "properties": { "tier": { "enum": ["minor", "major", "brutal"] }, "team": { "const": "physical" } } } },
          { "if": { "properties": { "kind": { "const": "goalie" } } },
            "then": { "required": ["resonants", "save"] } },
          { "if": { "properties": { "kind": { "const": "spell" } } },
            "then": { "required": ["spellType", "magic", "ability"] } }
        ]
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "ability": {
      "type": "object",
      "required": ["effect", "params"],
      "properties": {
        "effect": {
          "enum": ["bonus", "draw_on_win", "hits_harder", "hard_to_hurt", "boost", "shield", "dirty_play", "ward", "scry", "swap",
                   "long_pass", "long_shot", "steal", "recall", "hit", "mend",
                   "decoy_pass", "mirror_images",
                   "vs_holder", "reach", "needs_holder", "needs_shaken", "only_shaken", "shaken_anyway",
                   "shaken_is_injured", "self_check", "pile_on", "after_pass_or_shot", "after_losing"]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "effect": { "const": "bonus" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["stat", "amount"], "additionalProperties": false,
            "properties": {
              "stat": { "enum": ["speed", "shot", "defense", "faceoff", "save"] },
              "amount": { "type": "integer" },
              "when": { "enum": ["receive", "intercept", "tackle", "evade", "shoot", "save", "faceoff", "resist", "attack"] },
              "row": { "enum": ["defense", "midfield", "forward"] }
            } } } } },
        { "if": { "properties": { "effect": { "const": "draw_on_win" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["count"], "additionalProperties": false,
            "properties": { "count": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "const": "boost" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["amount"], "additionalProperties": false,
            "properties": {
              "amount": { "$ref": "#/$defs/count" },
              "when": { "enum": ["receive", "intercept", "tackle", "evade", "shoot", "save", "faceoff", "resist", "attack"] }
            } } } } },
        { "if": { "properties": { "effect": { "const": "steal" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["amount"], "additionalProperties": false,
            "properties": { "amount": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "const": "recall" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["count"], "additionalProperties": false,
            "properties": { "count": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "const": "hit" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["strength"], "additionalProperties": false,
            "properties": { "strength": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "const": "long_shot" } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["penalty"], "additionalProperties": false,
            "properties": { "penalty": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "enum": ["vs_holder", "pile_on", "hits_harder", "hard_to_hurt"] } } },
          "then": { "properties": { "params": {
            "type": "object", "required": ["amount"], "additionalProperties": false,
            "properties": { "amount": { "$ref": "#/$defs/count" } } } } } },
        { "if": { "properties": { "effect": { "enum": ["shield", "dirty_play", "ward", "scry", "swap", "long_pass", "mend", "decoy_pass", "mirror_images",
                                                       "reach", "needs_holder", "needs_shaken", "only_shaken", "shaken_anyway", "shaken_is_injured",
                                                       "self_check", "after_pass_or_shot", "after_losing"] } } },
          "then": { "properties": { "params": {
            "type": "object", "maxProperties": 0 } } } }
      ]
    }
  }
}
