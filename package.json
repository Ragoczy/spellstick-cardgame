{
  "name": "spellstick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "vite --mode online --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:online": "tsc --noEmit && vite build --mode online",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist-server/main.js",
    "server:dev": "tsx watch server/main.ts",
    "db:up": "docker compose up -d postgres",
    "env:pull": "bash scripts/pull-server-env.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx scripts/demo-game.ts",
    "sim": "tsx scripts/sim.ts",
    "generate-players": "tsx scripts/generate-players.ts",
    "assign-resonants": "tsx scripts/assign-resonants.ts",
    "assign-abilities": "tsx scripts/assign-abilities.ts",
    "spell-library-sim": "tsx scripts/spell-library-sim.ts",
    "spell-tiers": "tsx scripts/spell-tiers.ts",
    "measure-value": "tsx scripts/measure-value.ts",
    "price-players": "tsx scripts/price-players.ts",
    "roster-targets": "tsx scripts/roster-targets.ts",
    "sim-compare": "tsx scripts/sim-compare.ts",
    "generate-art": "tsx scripts/generate-art.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "2.5.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
