# Local settings for the game server. Make server/.env (which git ignores) with:
#   npm run env:pull
# That copies this file and fills in the shared Discord settings from Key Vault (you need to be
# signed in with "az login"). In Azure, the same names are set on the container app instead.

# The address you open in the browser. Locally that's the online dev server (npm run dev:online),
# which passes /api and /auth on to this server.
PUBLIC_URL=http://localhost:5180
PORT=8080

# Local Postgres from docker compose (npm run db:up).
DATABASE_URL=postgres://spellstick:spellstick@localhost:5433/spellstick

# ---- Shared by all Darkspace games: Key Vault kv-ha7siia4h4zia, Integrations--Discord--* ----
# Discord application: Spellstick's own (also its Discord Activity). Other games get their own.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Our Discord server.
DISCORD_GUILD_ID=
# Roles (comma-separated IDs): Players may sign in; Mods become moderators; Admins become admins.
DISCORD_PLAYER_ROLE_IDS=
DISCORD_MODERATOR_ROLE_IDS=
DISCORD_ADMIN_ROLE_IDS=
# Always let in as admins, even without a role, so the owner can't be locked out.
ADMIN_DISCORD_IDS=

# ---- Spellstick only ----
# Roles allowed to sign in instead of the Players role (for example a beta role). Empty = Players.
DISCORD_ALLOWED_ROLE_IDS=
SESSION_DAYS=7
# The Discord app that runs the game inside Discord (a Discord Activity), if it isn't the
# shared app above. Leave both empty to use the shared app (the current setup). Setting only
# the ID turns the Activity off, with a warning. See docs/discord-activity.md.
DISCORD_ACTIVITY_CLIENT_ID=
DISCORD_ACTIVITY_CLIENT_SECRET=

# Discord notifications (DMs about a player's matches). Empty: nothing is sent. See infra/README.md,
# "Discord notifications (bot)". Never commit a real token.
DISCORD_BOT_TOKEN=
