# Local settings for the game server. Copy to server/.env (which git ignores) and fill in.
# In Azure, the same names are set on the container app instead.

# The address you open in the browser. Locally that's the online dev server (npm run dev:online), which passes
# /api and /auth on to this server.
PUBLIC_URL=http://localhost:5180
PORT=8080

# Local Postgres from docker compose (npm run db:up).
DATABASE_URL=postgres://spellstick:spellstick@localhost:5433/spellstick

# Discord application "SpellstickCardgame". The secret lives in Key Vault; never commit it.
DISCORD_CLIENT_ID=1558444401032699954
DISCORD_CLIENT_SECRET=
# Our Discord server, and the role(s) allowed to sign in (comma-separated; empty = any member).
DISCORD_GUILD_ID=1308084311274160229
DISCORD_ALLOWED_ROLE_IDS=1348680742204477511
# Always allowed in, with the admin role (comma-separated Discord user IDs).
ADMIN_DISCORD_IDS=771010532458233888

SESSION_DAYS=7
