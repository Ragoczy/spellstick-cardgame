{
  // The server's own type check. No browser types here: this also proves the rules engine
  // runs without a browser (CLAUDE.md rule 1).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": ["./**/*.ts", "../src/engine/**/*.ts", "../src/data/**/*.ts", "../src/shared/**/*.ts", "../src/ai/**/*.ts"]
}
